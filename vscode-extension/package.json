{
  "name": "tcs-security-engine",
  "displayName": "TCS Security Engine",
  "description": "TimeCodeSecurity AST scanner with deterministic autofix for Python vulnerabilities",
  "version": "0.1.0",
  "publisher": "timecodesecurity",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Security"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tcs.scanCurrentFile",
        "title": "TCS: Scan Current File",
        "category": "TCS Security"
      }
    ],
    "configuration": {
      "title": "TCS Security Engine",
      "properties": {
        "tcs.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable running TCS CLI"
        },
        "tcs.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path to TCS cli.py (leave empty for auto-detect)"
        },
        "tcs.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan Python files on save"
        },
        "tcs.enableAutoFix": {
          "type": "boolean",
          "default": true,
          "description": "Enable deterministic autofix suggestions in diagnostics"
        },
        "tcs.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Timeout for TCS scan in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  },
  "dependencies": {}
}
